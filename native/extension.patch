+void ensure(bool ok, const std::string& what) {
+  if (!ok) throw std::runtime_error("NativeDiff: " + what);
+}
+std::string rankPrefix(const std::string& p) {
+  return p + ".rank" + std::to_string(mpi::rank());
+}
